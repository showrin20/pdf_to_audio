{
  "manifest_version": 3,
  "name": "PDF to Audiobook",
  "version": "0.1.0",
  "description": "Turn any PDF into a narrated audiobook: local extraction, AI text cleanup, and offline British-voice narration.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://speech.platform.bing.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/player/player.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
