{
  "manifest_version": 3,
  "name": "lazyears",
  "version": "0.1.1",
  "description": "Turn any PDF into a narrated audiobook: local extraction, AI text cleanup, and offline British-voice narration.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PDF to Audiobook",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "downloads",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "*://speech.platform.bing.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_edge_tts",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/player/player.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
